# Copy this file to .env and adjust as needed. A working .env with these same
# defaults already ships in this project so it runs out of the box — in a real
# deployment you would NOT commit .env (see .gitignore), only this .example file.

APP_NAME="Customer Churn Prediction API"
API_VERSION=3.0.0
PORT=8000

# Comma-separated list of allowed origins, or * for all (dev default).
# Tighten this before deploying somewhere public, e.g.:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=*

# slowapi / limits syntax: "<count>/<second|minute|hour|day>"
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_DEFAULT=120/minute

# Relative to the project root
MODEL_DIR=outputs
DATABASE_PATH=outputs/predictions.db

# Flag a customer as "Yes" when estimated churn probability >= this. Leave unset to
# use the balanced operating point from outputs/calibration.json (~0.265).
# DEFAULT_THRESHOLD=0.265

# If set, /predictions/history and /predictions/export.csv require an
# "X-API-Key: <this value>" header (they expose logged customer inputs).
# Leave empty for local dev; SET THIS before exposing the API publicly.
ADMIN_API_KEY=
